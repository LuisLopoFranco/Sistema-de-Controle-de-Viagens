# Copie este arquivo para .env e preencha os valores.
# O .env NÃO deve ser versionado — ele está no .gitignore.
#
# Para gerar uma SECRET_KEY nova:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

SECRET_KEY=cole-aqui-a-chave-gerada

# True apenas na sua máquina. Nunca em servidor.
DEBUG=True

# Hosts que a aplicação aceita atender, separados por vírgula.
ALLOWED_HOSTS=localhost,127.0.0.1

# Origens confiáveis para CSRF. Necessário quando a aplicação roda atrás de
# proxy ou com domínio próprio. Em desenvolvimento pode ficar vazio.
CSRF_TRUSTED_ORIGINS=

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
