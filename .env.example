# Copie para .env e preencha. O .env não é versionado.
#
# Gerar uma SECRET_KEY:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

SECRET_KEY=cole-aqui-a-chave-gerada

# True apenas na sua máquina. Nunca em servidor.
DEBUG=True

ALLOWED_HOSTS=localhost,127.0.0.1

# Origens confiáveis para CSRF. Necessário com domínio próprio ou proxy.
CSRF_TRUSTED_ORIGINS=

LOG_LEVEL=INFO

# --- Banco de dados -------------------------------------------------------
# sqlite (padrão, para desenvolvimento) ou postgres.
# O docker-compose define postgres automaticamente; estas variáveis valem
# para rodar contra o Postgres fora do Docker.
DATABASE_ENGINE=sqlite

POSTGRES_DB=viagens
POSTGRES_USER=viagens
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
